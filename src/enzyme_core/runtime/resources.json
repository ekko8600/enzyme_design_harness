{
  "schema_version": "enzyme-core/resources/v1",
  "description": "Runtime environment and model/binary resource declarations for canonical enzyme_core Skills.",
  "default_env": "agent",
  "groups": {
    "agent": "agent",
    "alphafold": "agent",
    "boltz": "agent",
    "esm": "agent",
    "esmif": "agent",
    "gemme": "agent",
    "mpnn": "agent",
    "openmm": "agent",
    "pyrosetta": "agent",
    "saprot": "agent"
  },
  "skills": {
    "alphafold": "agent",
    "alphafold-database-fetch-and-analyze": "agent",
    "binding-affinity": "agent",
    "boltz": "agent",
    "enzyme-qm-ts": "agent",
    "chembl-database": "agent",
    "clinical-trials-database": "agent",
    "clinvar-database": "agent",
